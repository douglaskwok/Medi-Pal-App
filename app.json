{
  "expo": {
    "name": "Medi-Pal",
    "slug": "medipal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medipal.app",
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.medipal.app",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://medipal.app"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Medi-Pal to use your location to show nearby healthcare resources."
        }
      ],
      "expo-font"
    ],
    "scheme": "medipal",
    "owner": "shdkwok",
    "extra": {
      "router": {
        "origin": "https://medipal.app"
      },
      "eas": {
        "projectId": "16703e84-9d4c-4bb2-b003-b012ca5362de"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "platforms": ["ios", "android"],
    "updates": {
      "url": "https://u.expo.dev/16703e84-9d4c-4bb2-b003-b012ca5362de"
    }
  }
}
